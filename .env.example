# Database (PostgreSQL - Docker Compose port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/droply

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_characters_long

# ImageKit Storage
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id/

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

